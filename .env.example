# Copia questo file in `.env` e personalizza i valori.

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./watchsniper.db

# --- Telegram ---
# Lascia vuoto per disabilitare il bot (il resto del sistema funziona comunque).
TELEGRAM_BOT_TOKEN=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Scraper ---
SCRAPE_INTERVAL_SECONDS=300
SCRAPER_MIN_DELAY=2.0
SCRAPER_MAX_DELAY=7.0
SCRAPER_HEADLESS=true

# --- Analyzer ---
# Costi fissi stimati (spedizione assicurata, commissioni, autenticazione...)
ESTIMATED_FIXED_COSTS=300.0
# Soglia margine % usata dall'endpoint /api/deals
DEALS_MIN_MARGIN_PERCENTAGE=10.0

# --- Logging ---
LOG_LEVEL=INFO
